# ─── Application ───────────────────────────────────────────────────
NODE_ENV=development
NEXTJS_PORT=3000
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-nextauth-secret-change-in-production
JWT_SECRET=your-jwt-secret-change-in-production

# ─── PostgreSQL ────────────────────────────────────────────────────
POSTGRES_USER=arka
POSTGRES_PASSWORD=change-this-strong-password
POSTGRES_DB=arka_villa
POSTGRES_PORT=5432

# ─── Redis ─────────────────────────────────────────────────────────
REDIS_PASSWORD=change-this-redis-password
REDIS_PORT=6379

# ─── MinIO (Object Storage) ───────────────────────────────────────
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=change-this-minio-password
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# ─── n8n (Workflow Engine) ─────────────────────────────────────────
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=change-this-n8n-password
N8N_HOST=localhost
N8N_PORT=5678
N8N_WEBHOOK_URL=http://localhost:5678
N8N_DB=arka_n8n

# ─── Nginx ─────────────────────────────────────────────────────────
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443

# ─── External Services (configure for production) ─────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=

# ─── Email / SMTP ─────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@arka-villa.com

# ─── WhatsApp Business API ────────────────────────────────────────
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=

# ─── Marketing / Ads ──────────────────────────────────────────────
META_APP_ID=
META_APP_SECRET=
META_ACCESS_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=

# ─── AI / LLM Agent ───────────────────────────────────────────────
AI_AGENT_URL=http://localhost:8080
AI_AGENT_API_KEY=

# ─── OTA Channels ─────────────────────────────────────────────────
BOOKING_COM_API_KEY=
BOOKING_COM_HOTEL_ID=
AIRBNB_API_KEY=
